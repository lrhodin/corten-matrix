# IDE / editor
.idea/
.vscode/

# Config & runtime data (generated per-install)
*.yaml
!.pre-commit-config.yaml
!example-config.yaml
!example-registration.yaml
*.session
*.json
*.db*
*.log

# Docker (per-host compose + env, never commit). Dockerfile and
# docker-compose.example.yml stay tracked.
docker-compose.yml
docker-compose.override.yml
.env

# Built binaries
/dist/
/corten-matrix
/corten-matrix-v2
/mautrix-imessage
/mautrix-imessage-v2
/mautrix-imessage.app
/extract-key
/extract-key-intel
/start
/data/
/build/
/bbctl

# Local external worktrees / generated app workspace.
# The workflow's private checkout and any private overlay staging must never be
# visible to normal `git add`; the pre-commit hook also blocks forced staging.
/opencider/
/private-go/
/rustpush/apple-private-apis/
# third_party/rustpush-upstream is where build.sh clones rustpush upstream and
# overlays our PRIVATE clean-room (open-absinthe + apple-private-apis) — never
# commit it or the private APIs would leak into the public bridge repo.
/third_party/rustpush-upstream/
/openbubbles-app-rustpush/
/rustpush-master/

# Rust build artifacts. librustpushgo.a IS the sealed clean-room as machine code.
librustpushgo.a
**/target/
state/
rustpush/certs/fairplay/


# Development/test prompt files
ENDTOEND_TEST_PROMPT.md
RUSTPUSH_INTEGRATION_PROMPT.md
prompts/
